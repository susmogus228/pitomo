# Copy to .env and fill secrets before docker compose starts.
# For local Python use 127.0.0.1:5432 instead of postgres:5432.
# Generate separate URL-safe passwords/keys; URL-encode special password characters.
POSTGRES_DB=petshop
POSTGRES_USER=petshop
POSTGRES_PASSWORD=
PETSHOP_DATABASE_URL=
PETSHOP_JWT_SECRET=
PETSHOP_ENV=production
PETSHOP_ACCESS_TOKEN_MINUTES=30
PETSHOP_SQL_ECHO=false
PETSHOP_CORS_ORIGINS=
# For temporary external HTTPS access, set all three fields to the same exact host.
# Example: PETSHOP_PUBLIC_HOST=shop.example.ts.net (no scheme or slash).
PETSHOP_PUBLIC_HOST=
PETSHOP_PUBLIC_ORIGIN=
PETSHOP_SECURE_COOKIES=false
PETSHOP_DOCS_ENABLED=false
PETSHOP_LOGIN_MAX_ATTEMPTS=5
PETSHOP_LOGIN_WINDOW_SECONDS=300
# Optional address suggestions for Kazakhstan; leave empty for manual address entry.
# Store the key only here, never in frontend source or VITE_* variables.
PETSHOP_GEOAPIFY_API_KEY=
PETSHOP_GEOAPIFY_DAILY_LIMIT=2800
# Consent documents stay a visibly labelled draft until reviewed by the owner.
# New registrations/consent grants are blocked in production while incomplete.
PETSHOP_PRIVACY_OPERATOR_NAME=
PETSHOP_PRIVACY_OPERATOR_ID=
PETSHOP_PRIVACY_CONTACT_EMAIL=
PETSHOP_PRIVACY_STORAGE_COUNTRY=
PETSHOP_PRIVACY_DOCUMENTS_APPROVED=false
PETSHOP_IMAGE=petshop-api:0.14.0
PETSHOP_HTTP_PORT=8000
PETSHOP_WEB_PORT=8080
PETSHOP_WEB_IMAGE=pitomo-web:0.14.0
# Only used with docker-compose.dev.yml; PostgreSQL binds to loopback.
PETSHOP_POSTGRES_PORT=5432
